# EverNothing Configuration
# Copy this file to .env and fill in your values
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

# S3 Bucket Configuration
S3_BUCKET_NAME=your-bucket-name-here
AWS_REGION=us-east-1

# AWS Credentials (Option 1: Direct credentials — prefer IAM roles in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Profile (Option 2: Use AWS CLI profile)
AWS_PROFILE=

# Database Configuration
DB_FILE=evernothing.db

# Application Configuration — MUST be set before running
SECRET_KEY=
# Encryption is ON by default. The AES-256 key is derived from SECRET_KEY
# using PBKDF2-SHA256 — no separate key file needed.
# WARNING: changing SECRET_KEY will make existing encrypted notes unreadable.
ENCRYPTION_ENABLED=true
ADMIN_USER=
ADMIN_PASS=

# Session Configuration
SESSION_TIMEOUT_HOURS=2
REMEMBER_COOKIE_DAYS=30
# Set to true when running behind HTTPS (required in production)
SESSION_COOKIE_SECURE=false
