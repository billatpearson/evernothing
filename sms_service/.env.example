# SMS Receive Service Configuration
# Copy to .env and fill in your values

# AWS Region
AWS_REGION=us-east-1

# AWS Credentials (prefer IAM roles in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Pinpoint Application ID (from AWS Console → Pinpoint → All projects)
PINPOINT_APP_ID=

# Your Pinpoint phone number in E.164 format (e.g. +18005551234)
PINPOINT_NUMBER=

# SNS Topic ARN for inbound SMS forwarding
SNS_TOPIC_ARN=

# Local settings
DB_FILE=sms.db
PORT=5050
SECRET_KEY=
