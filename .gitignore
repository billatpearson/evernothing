# --- TLS / HTTPS key material — NEVER commit -----------------------
# Private keys of any format
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
# Explicit paths — also listed in case a future reorg adds new dirs
Startup/cert.pem
Startup/key.pem
Startup/*.pem
Startup/*.key
Startup/*.crt
Scripts/cert.pem
Scripts/key.pem
# -----------------------------------------------------------------

# Pre-migration DB backups may contain secrets — never commit
*.bak
*.premigration_*
DB/Backups/

# S3 bucket-hardening sentinels (legacy + current path)
.bucket_policy_applied
log/.s3_bucket_hardened

# NSSM binary downloaded by the service installer — don't commit
Startup/service/nssm.exe
log/service.log*
log/service_err.log*

# Gzipped DB backups (created by the checkpoint job; not source)
*.db.gz
Backups/

# Kiro session-artifact helper scripts (ephemeral drivers)
.kiro-*.ps1
