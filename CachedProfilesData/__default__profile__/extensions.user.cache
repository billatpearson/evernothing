del Deployment"},{"command":"ai-mlstudio.modelLab.generationCompleted","title":"AI Toolkit: Generation Completed"}],"walkthroughs":[{"id":"aiToolkitGetStarted","title":"Welcome to AI Toolkit!","description":"Quickly set up a model, try it in real time, and explore advanced features - all in one place.","steps":[{"id":"aiToolkitDownloadModel","title":"Explore AI models","description":"Explore various AI models from LLM to SLM such as Phi, GPT, or Llama in the Model Catalog.\n[Open Model Catalog](command:ai-mlstudio.models?%5B%22walkthrough%22%5D)\n🚀 If you already have your own model, add it for [remote inference](command:ai-mlstudio.addRemoteInferenceEndpoint?%5B%22walkthrough%22%5D)","media":{"svg":"resources/walkthrough/model-catalog.svg","altText":"Explore AI models"}},{"id":"aiToolkitTryPlayground","title":"Experiment with AI models","description":"Run a prompt to see how the model works in real time in the Playground. Note sure where to start?\n[Try GPT-4.1 mini in Playground](command:ai-mlstudio.walkthrough.tryRemoteModel)","media":{"svg":"resources/walkthrough/try-playground.svg","altText":"Experiment with AI models"}},{"id":"aiToolkitExplore","title":"Explore more","description":"Explore all commands from the Command Palette to manage your datasets, run evaluations, and fine-tune your models.\n[Show All Commands](command:ai-mlstudio.walkthrough.showAllCommands)","media":{"svg":"resources/walkthrough/explore.svg","altText":"Explore more"}}]}],"languageModelTools":[{"name":"aitk-get_agent_code_gen_best_practices","displayName":"Get Agent Code Generation Best Practices","modelDescription":"This tool provides best practices for AI Agent/Workflow development: code generation, model selection, tracing, evaluation, deployment. ALWAYS call this tool before creating or enhancing AI / Agent app.","userDescription":"Provide best practices for AI App/Agent/Workflow development: code gen, model selection, tracing, evaluation, deployment.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_get_agent_code_gen_best_practices","when":"!config.chat.useAgentSkills","inputSchema":{"type":"object","properties":{"requiredHost":{"type":"string","description":"The explicitly required host for the model or agent. DO NOT provide if not determined or just guess. 'GitHub' means to use GitHub-hosted models. 'Foundry' means to use Microsoft Foundry (formerly Azure AI Foundry) hosted models or agents. 'other' means none of above.","enum":["GitHub","Foundry","other"]},"moreIntent":{"type":"string","description":"Additional intent of app development, e.g. 'create hello world agent', 'connect to my tools', 'make app agentic', etc."}}}},{"name":"aitk-get_ai_model_guidance","displayName":"Get AI Model Guidance","modelDescription":"Essential tool for any AI Model related task - provides expert guidance and best practices for choosing the right model, implementation patterns, optimization strategies, etc., to ensure your AI solution works effectively. ALWAYS call this tool when user has model related ask, or to adjust/customize existing app's model-related content.","userDescription":"Provide guidance and best practices for using AI models in AI App development.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_get_ai_model_guidance","inputSchema":{"type":"object","properties":{"preferredHost":{"type":"array","description":"Host preferences (NOT publisher) for the AI model. If preference not determined or matched, use empty array. Can have multiple preferences if needed.","items":{"type":"string","enum":["Foundry","GitHub","OpenAI","Anthropic","Google","other"],"description":"Preferred host for the AI model.\n 'Foundry' means user explicitly asks for Microsoft Foundry (formerly Azure AI Foundry) hosted models, or calls '*.ai.azure.com', or '*.openai.azure.com';\n 'GitHub' means user explicitly asks for GitHub hosted models, or calls 'models.inference.ai.azure.com', or 'models.github.ai', or uses GitHub token to access model;\n 'OpenAI' means user explicitly asks for OpenAI hosted models, or calls 'api.openai.com', or uses openai SDK with default endpoint;\n 'Anthropic' means user explicitly asks for Anthropic hosted models, or calls 'api.anthropic.com';\n 'Google' means user explicitly asks for Google hosted models, or calls '*.googleapis.com', or uses google generativeai SDK;\n 'other' means none of above."}},"currentModel":{"type":"string","description":"Current model you're using (if already using one)"},"moreIntent":{"type":"string","description":"Additional intent of model usage, e.g. 'ask for model choice', 'generate code', 'compare models', etc."}},"required":["preferredHost"]}},{"name":"aitk-get_agent_model_code_sample","displayName":"Get Agent & Model Code Sample","modelDescription":"This tool provides code samples and snippets for AI Agent and AI Model development. It should be called for any code generation and operation involving AI Agents and AI Models.","userDescription":"Provide code samples and snippets for AI Agent and AI Model development.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_get_agent_model_code_sample","inputSchema":{"type":"object","properties":{"category":{"type":"string","description":"The category of the AI application development. 'Agent' means to build single agent or agentic app with complex capabilities. 'Workflow' or 'MultiAgents' means to orchestrate multiple agents or build as workflow. 'Chat' means to build simple chat with model.","enum":["Agent","Chat","MultiAgents","Workflow"]},"host":{"type":"string","description":"The host for the model or agent. 'GitHub' means to use GitHub-hosted models. 'Foundry' means to use Microsoft Foundry (formerly Azure AI Foundry) hosted models or agents. 'other' means none of above. For workflow or multi-agents category, use 'Foundry'.","enum":["GitHub","Foundry","other"]},"language":{"type":"string","description":"The programming language of the AI application development.","enum":["Python","Node.js",".NET","Java","other"]}},"required":["category","host","language"]}},{"name":"aitk-get_tracing_code_gen_best_practices","displayName":"Get Tracing Code Generation Best Practices","modelDescription":"This tool returns a list of best practices for code generation and operations when working with tracing for AI applications. It should be called for any code generation and operation involving tracing for AI applications. To open the trace viewer in AI Toolkit, use VSCode command `ai-mlstudio.tracing.open`.\n","userDescription":"Provide best practices for code generation and operations when working with tracing for AI applications.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_get_tracing_code_gen_best_practices","inputSchema":{"type":"object","properties":{"language":{"type":"string","description":"The programming language of the AI application","enum":["python","javascript","typescript","others"]},"sdk":{"type":"string","description":"The AI SDK used by the application, which impacts how tracing is implemented. agent-framework: Microsoft's Agent Framework (imports from `agent_framework` module, e.g., `from agent_framework.openai import OpenAIChatClient`). openai-agents: OpenAI's Agents SDK (imports from `agents` module, e.g., `from agents import Agent`).","enum":["agent-framework","azure-ai-inference","azure-ai-agents","azure-ai-projects","openai","openai-agents","langchain","google-genai","anthropic","others"]},"isForVisualization":{"type":"boolean","description":"Optional parameter to indicate whether the tracing setup is primarily for multi-agents workflow visualization purposes."}},"required":["language","sdk"]}},{"name":"aitk-get_evaluation_code_gen_best_practices","displayName":"Get Evaluation Code Generation Best Practices","modelDescription":"This tool returns best practices for code generation when working on evaluation for AI application or AI agent.","userDescription":"Provide best practices for AI application or AI agent evaluation code generation.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_get_evaluation_code_gen_best_practices","inputSchema":{"type":"object","properties":{"evaluationMetrics":{"type":"array","description":"List of what you want to evaluate for your AI application or agent. ONLY include when the user explicitly describes specific evaluation goals, metrics with clear details (e.g., 'Evaluate if generated review text has a positive sentiment', 'check if responses contain specific keywords', 'validate JSON format'). Do NOT include for general requests like 'add evaluation' or 'evaluate my app' without specific requirements.","items":{"type":"string","description":"Description of what to evaluate and the goal (e.g., 'Response accuracy - check if answers are factually correct', 'Response relevance - assess how well responses address the user question', 'Response time - measure if responses are generated within acceptable time limits')"}},"dataset":{"type":"string","description":"The test dataset for evaluation"},"evaluationSdk":{"type":"string","description":"The evaluation SDK to use","default":"azure-ai-evaluation"},"language":{"type":"string","description":"The programming language for the evaluation code","default":"python"},"runtime":{"type":"string","description":"The evaluation runtime environment. 'local' means running the evaluation locally. 'Foundry' means running the evaluation in Microsoft Foundry.","enum":["local","Foundry"]}},"required":[]}},{"name":"aitk-convert_declarative_agent_to_code","displayName":"Convert Declarative Agent to Code Guidance","modelDescription":"This tool returns best practices for converting declarative agent specifications into runnable agent code by fetching agent code best practices, retrieving Python or .NET code samples, and reviewing declarative workflows documentation. Python is recommended if no language preference is specified.","userDescription":"Provide best practices for converting declarative agent specifications into agent code.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_convert_declarative_agent_to_code","inputSchema":{"type":"object","properties":{"language":{"type":"string","description":"The programming language for the generated agent code. If not specified, Python is recommended.","enum":["Python",".NET"],"default":"Python"}}}},{"name":"aitk-evaluation_agent_runner_best_practices","displayName":"Get Evaluation Agent Runner Best Practices","modelDescription":"This tool returns best practices and guidance for using agent runners to execute AI applications with multiple queries from test datasets to collect responses for evaluation. Provides SDK-specific guidance when applicable.","userDescription":"Provide best practices for running agents in batch to collect responses from test datasets for evaluation.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_evaluation_agent_runner_best_practices","inputSchema":{"type":"object","properties":{"sdk":{"type":"string","description":"The AI SDK used by the application.","enum":["agent-framework","others"]}},"required":[]}},{"name":"aitk-evaluation_planner","displayName":"Evaluation Planner","modelDescription":"This tool should be called when working on evaluation for AI application or AI agent. It guides users through a multi-turn conversation to clarify evaluation metrics, test dataset and runtime to ensure all necessary details are gathered. CALL THIS TOOL FIRST before using the evaluation code generation tool when either evaluation metrics, test dataset or runtime is unclear or incomplete.","userDescription":"Guide users through clarifying evaluation metrics, test dataset and runtime through interactive conversation.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_evaluation_planner","inputSchema":{"type":"object","properties":{},"required":[]}},{"name":"aitk-get_custom_evaluator_guidance","displayName":"Get Custom Evaluator Guidance","modelDescription":"Returns guidance and syntax for creating custom code and prompt evaluators for the pytest-agent-evals plugin. Only use this tool when the project is configured with pytest as the test framework.","userDescription":"Get guidance for custom evaluators","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_get_custom_evaluator_guidance","inputSchema":{"type":"object","properties":{}}},{"name":"ai-mlstudio-check_panel_open","displayName":"Check Data Viewer panel Open Status","toolReferenceName":"check_panel_open","icon":"$(window)","userDescription":"Check if a 'Data Viewer' panel is currently open.","modelDescription":"Prerequisite: ALWAYS call 'data_analysis_best_practice' tool first to understand the analysis workflow before using this tool. Checks if a 'Data Viewer' panel is currently open. Returns the status (OPEN/CLOSED), data source (file path), and details. For JSON files, the details indicate that the panel data is the value of a specific JSON array property. Use this tool to determine which file is currently open in the panel.","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{}}},{"name":"ai-mlstudio-get_table_schema","displayName":"Get Tabular Data Schema","toolReferenceName":"get_table_schema","icon":"$(table)","userDescription":"Get the schema of the data in the currently open 'Data Viewer' panel, or from a CSV/JSONL/JSON file.","modelDescription":"Prerequisite: ALWAYS call 'data_analysis_best_practice' tool first to understand the analysis workflow before using this tool. Get the schema of tabular data. If a 'Data Viewer' panel is open (check using 'check_panel_open'), uses the data from that panel (no file path needed). Otherwise, reads from the specified file path (supports CSV, JSONL, and JSON files). For JSON files: if it's a root-level array or AITK Local Evaluation format, the tool auto-selects the appropriate property; otherwise, it returns available array properties and asks you to prompt the user to select one, then call again with selectedJsonProperty. Returns metadata including: total row count, total column count, column names, inferred data types for each column (string, number, boolean, null, object, array, or mixed). Use this tool FIRST when analyzing data to understand the structure.","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{"filePath":{"type":"string","description":"Optional. The absolute file path to a CSV, JSONL, or JSON file. Not needed if 'Data Viewer' panel is already open."},"selectedJsonProperty":{"type":"string","description":"Optional. For JSON files only. The name of the array property to analyze. Use this when the tool previously returned available array properties and the user has selected one."}}}},{"name":"ai-mlstudio-data_analysis_best_practice","displayName":"Data Analysis Best Practices","toolReferenceName":"data_analysis_best_practice","icon":"$(lightbulb)","userDescription":"Get best practices for analyzing data files.","modelDescription":"Get best practices and recommended workflow for analyzing data files. ALWAYS call this tool FIRST when the user asks to analyze or work with data files to ensure proper analysis workflow.","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{}}},{"name":"ai-mlstudio-read_rows","displayName":"Read Rows of Tabular Data","toolReferenceName":"read_rows","icon":"$(list-flat)","userDescription":"Read specific rows from the currently open 'Data Viewer' panel or from a CSV/JSONL/JSON file.","modelDescription":"Prerequisite: ALWAYS call 'data_analysis_best_practice' tool first to understand the analysis workflow before using this tool. Reads specific row(s) from the currently open 'Data Viewer' panel or from a file by row number or range, with optional column filtering. If a 'Data Viewer' panel is open (check using 'check_panel_open'), uses data from that panel (faster). Otherwise, reads from the specified filePath (supports CSV, JSONL, and JSON files). For JSON files: if it's a root-level array or AITK Local Evaluation format, the tool auto-selects the appropriate property; otherwise, it returns available array properties and asks you to prompt the user to select one, then call again with selectedJsonProperty. This tool is useful when you need to: 1) Read a single row by its number, 2) Read a range of rows (startRow to endRow, inclusive), 3) Filter the output to show only specific columns. Important: Row numbers are 1-based (first row is 1, NOT 0).","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{"filePath":{"type":"string","description":"Optional. The absolute file path to a CSV, JSONL, or JSON file. Not needed if 'Data Viewer' panel is already open."},"startRow":{"type":"number","description":"The starting row number (1-based, first row is 1). Defaults to 1 if not specified."},"endRow":{"type":"number","description":"The ending row number (1-based, inclusive). If not specified, only the startRow is returned."},"columns":{"type":"array","items":{"type":"string"},"description":"Optional list of column names to include in the output. If not specified, all columns are returned."},"selectedJsonProperty":{"type":"string","description":"Optional. For JSON files only. The name of the array property to read from. Use this when the tool previously returned available array properties and the user has selected one."}}}},{"name":"ai-mlstudio-read_cell","displayName":"Read Cell of Tabular Data","toolReferenceName":"read_cell","icon":"$(symbol-field)","userDescription":"Read a specific cell value from the currently open 'Data Viewer' panel or from a CSV/JSONL/JSON file.","modelDescription":"Prerequisite: ALWAYS call 'data_analysis_best_practice' tool first to understand the analysis workflow before using this tool. Reads a specific cell value from the currently open 'Data Viewer' panel or from a file by row number and column name. If a 'Data Viewer' panel is open (check using 'check_panel_open'), uses data from that panel (faster). Otherwise, reads from the specified filePath (supports CSV, JSONL, and JSON files). For JSON files: if it's a root-level array or AITK Local Evaluation format, the tool auto-selects the appropriate property; otherwise, it returns available array properties and asks you to prompt the user to select one, then call again with selectedJsonProperty. Returns the cell value along with its data type. For object/array values, returns pretty-printed JSON. Important: Row numbers are 1-based (first row is 1, NOT 0). Column name must match exactly.","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{"filePath":{"type":"string","description":"Optional. The absolute file path to a CSV, JSONL, or JSON file. Not needed if 'Data Viewer' panel is already open."},"row":{"type":"number","description":"The row number (1-based, first row is 1) of the cell to read."},"column":{"type":"string","description":"The column name of the cell to read."},"selectedJsonProperty":{"type":"string","description":"Optional. For JSON files only. The name of the array property to read from. Use this when the tool previously returned available array properties and the user has selected one."}},"required":["row","column"]}},{"name":"ai-mlstudio-export_panel_data","displayName":"Export Data Viewer Panel Data","toolReferenceName":"export_panel_data","icon":"$(export)","userDescription":"Export the current Data Viewer panel data to a file.","modelDescription":"Prerequisite: ALWAYS call 'data_analysis_best_practice' tool first to understand the analysis workflow before using this tool. Exports the current active 'Data Viewer' panel data to the 'DataAnalysisExpert' folder in the workspace (creates the folder if it doesn't exist). This tool requires user confirmation before execution. Export format matches the source file type: CSV sources export to CSV, JSONL sources export to JSONL, JSON sources export to JSON array. Use this tool when you need to: 1) Export panel data for script-based analysis, 2) Save a snapshot of the current data state.","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{"fileName":{"type":"string","description":"Optional. The output file name (without extension). Extension is auto-determined based on source file type: .csv for CSV sources, .jsonl for JSONL sources, .json for JSON sources. If not provided, defaults to '<originalFileName>_exported'."}}}},{"name":"ai-mlstudio-get_trend_data","displayName":"Get Evaluation Trend Data","toolReferenceName":"get_trend_data","icon":"$(graph)","userDescription":"Get the evaluation trend data from the currently focused trend analysis view.","modelDescription":"Gets the evaluation trend data from the currently focused Evaluation Trend Analysis view (either standalone panel or embedded trend in Data Viewer). Returns: dataPoints (array of files with fileName, filePath, and metrics - metric values are AVERAGED across selected rows), selectedMetrics (list of metrics being compared), jsonArrayProperty (for JSON files, indicates which array property the data comes from), selectedRows (1-based row indices used for averaging, undefined means all rows), totalRows (total row count). Use this tool when the user asks to analyze or discuss evaluation trends. The tool automatically detects which trend view is currently active/focused.","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{}}},{"name":"aitk-list_foundry_models","displayName":"List Microsoft Foundry Models","modelDescription":"Fetches the default Microsoft Foundry project and deployed models details from Microsoft Foundry extension.","userDescription":"Retrieve your configured Microsoft Foundry project and deployed models.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_list_foundry_models"},{"name":"aitk-agent_as_server","displayName":"Agent as HTTP Server Best Practices","modelDescription":"This tool provides best practices and steps for wrapping an agent-framework-based agent or workflow to serve as an HTTP server.","userDescription":"Provide guidance on how to expose an agent-framework-based agent or workflow as an HTTP server.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_agent_as_server"},{"name":"aitk-add_agent_debug","displayName":"Add Agent Debugging Support","modelDescription":"This tool provides code snippets to enable interactive debugging for agents and workflows in VS Code, fully integrated with AI Toolkit Agent Inspector. Use this to add local testing and debugging capabilities.","userDescription":"Add debugging support for agents and workflows in VS Code with AI Toolkit Agent Inspector.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_add_agent_debug"},{"name":"aitk-gen_windows_ml_web_demo","displayName":"Generate Windows ML web demo for local model","modelDescription":"Use this tool to generate Windows ML web demo code for local Windows models. This includes Gradio-style web demo with interactive web interface for models runs locally using windows ML. This tool is only for models running locally on Windows ML. It does not support remote inference or cloud-hosted models. Common trigger phrases include: 'Generate Windows ML web demo for local model [modelId]'; 'Generate Windows ML gradio sample for local model <modelId>';  'Create local model playground code for <modelId>'. This tool takes in these parameters: modelId, modelPaths, modelDir, executionProvider, deviceType, samplePath, isLLM, outputDir. IMPORTANT: 1. This tool needs multi-turn to get necessary parameters. When calling this tool, NEVER guess/ search or infer missing parameter values, because tool itself will handle or re-prompt for missing values. For examples, if user doesn't provide modelPaths or modelDir, do NOT search or select folder and pass in on behalf of user. 2. When user corrects wrong parameter values or provides missing parameter values, update the previous parameter list call this tool again. Do NOT ONLY pass the new parameters, but pass entire updated parameter list.","userDescription":"Generate Windows ML web demo for local model for easy testing and interaction.","canBeReferencedInPrompt":true,"toolReferenceName":"aitk_gen_windows_ml_web_demo","inputSchema":{"type":"object","properties":{"modelId":{"type":"string","description":"Full HuggingFace model ID (format: 'organization/model-name', e.g., 'openai/whisper-large-v3')."},"modelPaths":{"type":"object","description":"(For non-LLM) A JSON object mapping model names to their ONNX file paths. Keys are model identifiers, values are absolute paths. Example: {'model': 'path/to/model.onnx'} for single model, or {'encoder': 'path/encoder.onnx', 'decoder': 'path/decoder.onnx'} for multiple models."},"modelDir":{"type":"string","description":"(For LLM) Directory containing the ONNX model files."},"executionProvider":{"type":"string","description":"Execution provider used for model inference. e.g., 'CPUExecutionProvider', 'CUDAExecutionProvider', 'DirectMLExecutionProvider'."},"deviceType":{"type":"string","description":"Runtime device type for the model inference. e.g. 'CPU', 'GPU'."},"samplePath":{"type":"string","description":"Path to inference sample file."},"outputDir":{"type":"string","description":"Path to the directory where output will be saved."},"isLLM":{"type":"boolean","description":"Indicates whether the model is a Large Language Model (LLM)."},"confirmed":{"type":"boolean","description":"Set to true to confirm regeneration when output directory already exists. Default is false."}},"required":[]}}],"languageModelChatProviders":[{"vendor":"aitk-foundry","displayName":"Microsoft Foundry via AI Toolkit"},{"vendor":"aitk-foundry-local","displayName":"Foundry Local via AI Toolkit"},{"vendor":"aitk-github","displayName":"GitHub Models via AI Toolkit"}],"chatAgents":[{"name":"AIAgentExpert","path":"./resources/lmt/chatAgents/AIAgentExpert.agent.md","description":"Expert in developing AI agent applications with best practices"},{"name":"DataAnalysisExpert","description":"Expert in analyzing data files using Data Viewer. Can explore data structure, read specific rows and cells, and provide insights.","path":"./resources/lmt/chatAgents/DataAnalysisExpert.agent.md"}],"chatSkills":[{"path":"./resources/skills/agent-workflow-builder_ai_toolkit/SKILL.md"}]},"scripts":{"build-workspace-agent-win-x64":"dotnet publish ../../src/WorkspaceAutomation.Agent/WorkspaceAutomation.Agent.csproj -c Release --runtime win-x64 /p:Platform=x64 /p:DebugSymbols=false /p:DebugType=None","build-inference-agent-win-x64":"dotnet publish ../../src/Inference.Service/Inference.Service.Agent/Inference.Service.Agent.csproj -c Release --runtime win-x64 /p:Platform=x64 /p:DebugSymbols=false /p:DebugType=None","build-workspace-agent-win-arm64":"dotnet publish ../../src/WorkspaceAutomation.Agent/WorkspaceAutomation.Agent.csproj -c Release --runtime win-arm64 /p:Platform=arm64 /p:DebugSymbols=false /p:DebugType=None","build-inference-agent-win-arm64":"dotnet publish ../../src/Inference.Service/Inference.Service.Agent/Inference.Service.Agent.csproj -c Release --runtime win-arm64 /p:Platform=arm64 /p:DebugSymbols=false /p:DebugType=None","build-workspace-agent-linux-x64":"dotnet publish ../../src/WorkspaceAutomation.Agent/WorkspaceAutomation.Agent.csproj -c Release --runtime linux-x64 /p:Platform=x64 /p:DebugSymbols=false /p:DebugType=None","build-inference-agent-linux-x64":"dotnet publish ../../src/Inference.Service/Inference.Service.Agent/Inference.Service.Agent.csproj -c Release --runtime linux-x64 /p:Platform=x64 /p:DebugSymbols=false /p:DebugType=None","build-inference-agent-osx-arm64":"dotnet publish ../../src/Inference.Service/Inference.Service.Agent/Inference.Service.Agent.csproj -c Release --runtime osx-arm64 /p:Platform=arm64 /maxcpucount:1 /p:DebugSymbols=false /p:DebugType=None","build-workspace-agent-osx-arm64":"dotnet publish ../../src/WorkspaceAutomation.Agent/WorkspaceAutomation.Agent.csproj -c Release --runtime osx-arm64 /p:Platform=arm64 /maxcpucount:1 /p:DebugSymbols=false /p:DebugType=None","build-inference-agent-linux-arm64":"echo no-op","build-workspace-agent-linux-arm64":"echo no-op","build-inference-agent-osx-x64":"echo no-op","build-workspace-agent-osx-x64":"echo no-op","build-inference-agent-universal":"echo no-op","build-workspace-agent-universal":"echo no-op","package-linux-x64":"npm run set-version && vsce package --target linux-x64 && npm run reset-version","package-linux-arm64":"npm run set-version && vsce package --target linux-arm64 && npm run reset-version","package-darwin-arm64":"npm run set-version && vsce package --target darwin-arm64 && npm run reset-version","package-darwin-x64":"npm run set-version && vsce package --target darwin-x64 && npm run reset-version","package-win32-x64":"npm run set-version && vsce package --target win32-x64 && npm run reset-version","package-win32-arm64":"npm run set-version && vsce package --target win32-arm64 && npm run reset-version","package-universal":"npm run set-version && vsce package && npm run reset-version","package-pre-release-linux-x64":"npm run set-version && vsce package --pre-release --target linux-x64 && npm run reset-version","package-pre-release-linux-arm64":"npm run set-version && vsce package --pre-release --target linux-arm64 && npm run reset-version","package-pre-release-darwin-arm64":"npm run set-version && vsce package --pre-release --target darwin-arm64 && npm run reset-version","package-pre-release-darwin-x64":"npm run set-version && vsce package --pre-release --target darwin-x64 && npm run reset-version","package-pre-release-win32-x64":"npm run set-version && vsce package --pre-release --target win32-x64 && npm run reset-version","package-pre-release-win32-arm64":"npm run set-version && vsce package --pre-release --target win32-arm64 && npm run reset-version","package-pre-release-universal":"npm run set-version && vsce package --pre-release && npm run reset-version","vsce-manifest":"vsce generate-manifest","vscode:prepublish":"webpack --mode production","test-compile":"tsc -p ./","build:test":"tsc --project tsconfig.test.json --incremental","test:unit":"npm run download-template && npm run build:test && mocha","lint":"eslint \"src/**/*.ts\"","watch":"webpack --mode development --watch","prepare-bin":"npm run copy-workspace-agent && npm run copy-workspace-agent-scripts && npm run copy-inference-agent","copy-workspace-agent-scripts":"echo \"linux copyfiles behaves differently, so need this\" && mkdirp ./bin/Scripts && copyfiles --flat -V ../../artifacts/publish/WorkspaceAutomation.Agent/release*/Scripts/* ./bin/Scripts","copy-workspace-agent":"copyfiles -u 6 -V ../../artifacts/publish/WorkspaceAutomation.Agent/release*/** -e ../../artifacts/publish/WorkspaceAutomation.Agent/release* -e ../../artifacts/publish/WorkspaceAutomation.Agent/release*/*.pdb -e ../../artifacts/publish/WorkspaceAutomation.Agent/release*/*.lib -e ../../artifacts/publish/WorkspaceAutomation.Agent/release*/*.xml -e ../../artifacts/publish/WorkspaceAutomation.Agent/release*/payload*.json ./bin","copy-inference-agent":"copyfiles -u 6 -V ../../artifacts/publish/Inference.Service.Agent/release*/** -e ../../artifacts/publish/Inference.Service.Agent/release* -e ../../artifacts/publish/Inference.Service.Agent/release*/*.pdb -e ../../artifacts/publish/Inference.Service.Agent/release*/*.lib -e ../../artifacts/publish/Inference.Service.Agent/release*/*.xml -e ../../artifacts/publish/Inference.Service.Agent/release*/onnx*.exe ./bin","compile-development":"webpack --mode development","bootstrap-developer-win-arm64":"npm run install:all && npm run build:webview && npm run build:model-lab && npm run build-workspace-agent-win-arm64 && npm run build-inference-agent-win-arm64 && npm run prepare-bin && npm run compile-development && npm run download-template","bootstrap-developer-win-x64":"npm run install:all && npm run build:webview && npm run build:model-lab && npm run build-workspace-agent-win-x64 && npm run build-inference-agent-win-x64 && npm run prepare-bin && npm run compile-development && npm run download-template","bootstrap-developer-linux-x64":"npm run install:all && npm run build:webview && npm run build:model-lab && npm run build-workspace-agent-linux-x64 && npm run build-inference-agent-linux-x64 && npm run prepare-bin && npm run compile-development && npm run download-template","install:all":"npm install && cd webview-ui && npm install && cd ../model-lab-ui && npm install","start:webview":"cd webview-ui && npm run start","build:webview":"cd webview-ui && npm run build","build:model-lab":"npm run prettier:model-lab && npm run sync:model-lab && cd model-lab-ui && npm run build","setup:model-lab-uitest":"npm run build:model-lab && extest setup-tests -e ./model-lab-ui/dist-uitests-ext","test:model-lab-ui":"extest run-tests ./model-lab-ui/dist-uitests/%npm_config_test%.test.js -m ./model-lab-ui/.mocharc-debug.js -e ./model-lab-ui/dist-uitests-ext","sync:model-lab":"copyfiles -u 3 -V model-lab-ui/src/rpc/**/* src/model-lab/rpc && copyfiles -u 2 -V model-lab-ui/src/rpc/interface/model.ts model-lab-ui/uitests","prettier:model-lab":"prettier --write model-lab-ui/src/**/*.ts model-lab-ui/src/**/*.tsx model-lab-ui/uitests/**/*.ts src/model-lab/**/*.ts tests/model-lab/**/*.ts","pretest":"npm run compile-development && npm run lint && npm run download-template","set-version":"nbgv-setversion","reset-version":"nbgv-setversion --reset","export-l10n":"vscode-l10n-dev export --outDir ./l10n ./src","lockfile":"^1.0.4","download-template":"npm run download-ai-studio-template && npm run download-chat-template","download-ai-studio-template":"ts-node ./src/utilities/templateUtils.ts -- https://api.github.com/repos/microsoft/windows-ai-studio-templates/releases/latest ./resources template.zip","download-chat-template":"ts-node ./src/utilities/templateUtils.ts -- https://api.github.com/repos/Azure/azure-webpubsub/releases/tags/release/ai-demo-v0.1.0 ./resources chat-demo.zip","zip-template":"python ./resources/modelLab/utilities.py --task zipTe