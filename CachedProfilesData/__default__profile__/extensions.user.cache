~3","~4"],"description":"The default version of the Azure Functions runtime to use when performing operations like \"Create New Function\".","enumDescriptions":["Azure Functions v1","Azure Functions v2","Azure Functions v3","Azure Functions v4"]},"azureFunctions.projectLanguage":{"scope":"resource","type":"string","enum":["C#","F#","C#Script","F#Script","Java","JavaScript","PowerShell","Python","TypeScript","Custom"],"description":"The default language to use when performing operations like \"Create New Function\".","enumDescriptions":["","","(Preview)","(Preview)","","","","","","",""]},"azureFunctions.projectLanguageModel":{"scope":"resource","type":"number","description":"The default language model to use when performing operations like \"Create New Function\".","minimum":0},"azureFunctions.projectTemplateKey":{"scope":"resource","type":"string","description":"A key used to identify which templates to use for this project. In most cases, this will be automatically detected and should not need to be set."},"azureFunctions.deploySubpath":{"scope":"resource","type":"string","description":"The default subpath of a workspace folder to use when deploying. If set, you will not be prompted for the folder path when deploying."},"azureFunctions.projectSubpath":{"scope":"resource","type":"string","description":"The default subpath of a workspace folder to use for project operations. This is only necessary if you have multiple projects in one workspace. See https://aka.ms/AA4nmfy for more information."},"azureFunctions.showCoreToolsWarning":{"type":"boolean","description":"Show a warning if your installed version of Azure Functions Core Tools is out-of-date.","default":true},"azureFunctions.showMultiCoreToolsWarning":{"type":"boolean","description":"Show a warning if multiple installs of Azure Functions Core Tools are detected.","default":true},"azureFunctions.show64BitWarning":{"type":"boolean","description":"Show a warning to install a 64-bit version of the Azure Functions Core Tools when you create a .NET Framework project.","default":true},"azureFunctions.enableRemoteDebugging":{"type":"boolean","description":"Enable remote debugging for Node.js Function Apps running on Linux App Service plans. Consumption plans are not supported. (experimental)","default":false},"azureFunctions.enableJavaRemoteDebugging":{"type":"boolean","description":"Enable remote debugging for Java Functions Apps running on Windows. (experimental)","default":false},"azureFunctions.showProjectWarning":{"type":"boolean","description":"Show a warning when an Azure Functions project was detected that has not been initialized for use in VS Code.","default":true},"azureFunctions.showPythonVenvWarning":{"type":"boolean","description":"Show a warning when an Azure Functions Python project was detected that does not have a virtual environment.","default":true},"azureFunctions.showDeploySubpathWarning":{"type":"boolean","description":"Show a warning when the \"deploySubpath\" setting does not match the selected folder for deploying.","default":true},"azureFunctions.showTargetFrameworkWarning":{"type":"boolean","description":"Show a warning when an Azure Functions .NET project was detected that has mismatched target frameworks.","default":true},"azureFunctions.showExtensionsCsprojWarning":{"type":"boolean","description":"Show a warning when an Azure Functions project was detected that has mismatched \"extensions.csproj\" configuration.","default":true},"azureFunctions.pickProcessTimeout":{"type":"integer","description":"The timeout (in seconds) to be used when searching for the Azure Functions host process. Since a build is required every time you F5, you may need to adjust this based on how long your build takes.","default":60},"azureFunctions.templateVersion":{"type":"string","description":"A runtime release version (any runtime) that species which templates will be used rather than the latest templates.  This version will be used for ALL runtimes. (Requires a restart of VS Code to take effect)"},"azureFunctions.projectOpenBehavior":{"type":"string","enum":["AddToWorkspace","OpenInNewWindow","OpenInCurrentWindow"],"description":"The behavior to use after creating a new project. The options are \"AddToWorkspace\", \"OpenInNewWindow\", or \"OpenInCurrentWindow\"."},"azureFunctions.preDeployTask":{"scope":"resource","type":"string","description":"The name of the task to run before zip deployments."},"azureFunctions.postDeployTask":{"scope":"resource","type":"string","description":"The name of the task to run after zip deployments."},"azureFunctions.pythonVenv":{"scope":"resource","type":"string","description":"The name of the Python virtual environment used for your project. A virtual environment is required to debug and deploy Python functions."},"azureFunctions.createPythonVenv":{"type":"boolean","description":"Create a virtual environment when creating a new Python project.","default":true},"azureFunctions.scmDoBuildDuringDeployment":{"scope":"resource","type":"boolean","description":"Set to true to build your project on the server. Currently only applicable for Linux Function Apps."},"azureFunctions.enableOutputTimestamps":{"type":"boolean","description":"Prepends each line displayed in the output channel with a timestamp.","default":true},"azureFunctions.stopFuncTaskPostDebug":{"type":"boolean","description":"Automatically stop the task running the Azure Functions host when a debug sessions ends.","default":true},"azureFunctions.showDeployConfirmation":{"type":"boolean","description":"Ask for confirmation before deploying to a Function App in Azure (deploying will overwrite any previous deployment and cannot be undone).","default":true},"azureFunctions.validateFuncCoreTools":{"type":"boolean","description":"Validate the Azure Functions Core Tools is installed before debugging.","default":true},"azureFunctions.requestTimeout":{"type":"number","description":"The timeout (in seconds) to be used when making requests, for example getting the latest templates.","default":15},"azureFunctions.hostStartTimeout":{"type":"number","description":"The timeout (in seconds) to be used when starting the Azure Functions host.","default":60},"azureFunctions.defaultFunctionAppToDeploy":{"scope":"resource","type":"string","description":"The default function app to use when deploying, represented by its full Azure id.  Every subsequent deployment of this workspace will deploy to this function app or slot."},"azureFunctions.suppressProject":{"scope":"resource","type":"boolean","description":"Set to true if this should not be recognized as an Azure Functions project and you want to hide related functionality.","default":false},"azureFunctions.showHiddenStacks":{"type":"boolean","description":"Show hidden runtime stacks when creating a Function App in Azure. WARNING: These stacks may be in preview or may not be available in all regions.","default":false},"azureFunctions.showDeprecatedStacks":{"type":"boolean","description":"Show deprecated runtime stacks when creating a Function App in Azure. WARNING: These stacks may be removed at any time and may not be available in all regions.","default":false},"azureFunctions.showReloadTemplates":{"type":"boolean","description":"Show an option to reload templates when creating a function. This will clear the template cache.","default":false},"azureFunctions.enableOpenFromPortal":{"type":"boolean","description":"Enable download content and setup project feature using handle uri (experimental)","default":false},"azureFunctions.javaBuildTool":{"scope":"resource","type":"string","default":"maven","enum":["maven","gradle"],"description":"Build tool for Java Functions project"},"azureFunctions.templateSource":{"type":"string","description":"For development purposes only. You must reload your VS Code window for this to take effect.","enum":["","Staging","Backup"],"enumDescriptions":["Default behavior using the best source available.","Use the very latest templates from the staging template source.","Use backup templates included in the extension's vsix. These may not have the latest updates."]},"azureFunctions.funcCliPath":{"scope":"resource","type":"string","description":"The path to the 'func' executable to use for debug and deploy tasks. For example, set it to 'node_modules/.bin/func' if using the func cli installed as a local npm package."},"azureFunctions.endOfLifeWarning":{"type":"boolean","description":"Show a warning when creating Function Apps with stacks within 6 months of their end of life.","default":true},"azureFunctions.functionSubpath":{"scope":"resource","type":"string","default":"src/functions","description":"The default subpath to create new functions. Currently, this only applies to Node.js programming model v4+."},"azureFunctions.showFlexEventGridWarning":{"type":"boolean","description":"Show a warning when deploying a Azure Blob Storage Trigger (using Event Grid) to a Flex Consumption Function App.","default":true},"azureFunctions.showMarkdownPreview":{"type":"boolean","description":"Enables showing the markdown preview after creating a new PythonV2 template","default":true},"azureFunctions.allowProgrammingModelSelection":{"type":"boolean","description":"Allow the user to select a programming model when creating a new function project.","default":false},"azureFunctions.showBallerinaProjectCreation":{"type":"boolean","description":"Show the option to create a Ballerina Function projects when creating a new Function project.","default":false},"azureFunctions.mcpProjectType":{"type":"string","description":"The type of MCP integration the project uses.","enum":["NoMcpServer","McpExtensionServer","SelfHostedMcpServer"],"enumDescriptions":["Runs the standard Azure Functions runtime with no MCP integration.","Runs the Functions host with an embedded MCP server provided by the Azure Functions MCP extension.","Runs the Functions host in custom-handler mode, forwarding requests to a self-hosted MCP server process."]}}}],"walkthroug